rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Secure: Users can only read/write their OWN data
    // Admin: Can read/write EVERYTHING
    // Exception: Students can read their Teacher's profile (specifically for WhatsApp/Contact info)
    match /users/{userId} {
      allow read: if request.auth != null && (
          request.auth.uid == userId || 
          isAdmin() ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedTeacher == userId)
      );
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Global Students collection
    match /students/{studentId} {
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid || 
        resource.data.userUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if request.auth != null && (resource.data.teacherUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // Global Lessons collection
    match /lessons/{lessonId} {
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid || 
        resource.data.userUid == request.auth.uid ||
        (resource.data.studentId != null && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userUid == request.auth.uid) ||
        isAdmin()
      );
      allow write, create: if request.auth != null && (
        (request.resource != null && request.resource.data.teacherUid == request.auth.uid) || 
        (resource != null && resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      );
    }
    
    match /student_links/{email} {
      allow read, write: if request.auth != null;
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
